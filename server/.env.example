# ==============================================================================
# Astra Pathways — Production Environment Variables
# ==============================================================================

# Server Port (Render sets this automatically; do NOT hardcode in Render dashboard)
PORT=5000

# Node Environment: 'production' enables rate limiting, security headers, and minified serving
NODE_ENV=production

# JSON Web Token Secret
# CRITICAL: Replace with a secure 32+ character random secret in production
# (e.g. generate via `openssl rand -hex 32` or let Render Blueprint generate it)
JWT_SECRET=replace_with_a_secure_random_secret_in_production_32_chars_min

# Allowed Frontend Origins for CORS (comma-separated if multiple)
# When the React client is served directly by Express on Render, this can remain blank.
# If hosting the frontend on a separate domain (e.g. Vercel/Netlify), set to that URL.
CLIENT_ORIGIN=https://astra-pathways.onrender.com

# SQLite Database Storage Location
# On Render Free Tier: use ./data/astra.db (auto-created and auto-seeded if empty)
# On Render with Persistent Disk: set to /var/data/astra.db (where /var/data is the disk mount path)
DATABASE_FILE=./data/astra.db
